#!/bin/sh
# pre-commit: 攻略内容有改动时自动递增版本号（三级语义化）
# 触发条件：本次提交包含 heroes-data.js 或 index.html（内容/界面更新）
# 档位（通过环境变量 VERSION_BUMP 指定，缺省=patch）：
#   major -> +1.0.0（大更新）   minor -> +0.1（中更新）   patch -> +0.0.1（小更新，默认）
set -e

ROOT=$(git rev-parse --show-toplevel)
FILE="heroes-data.js"

# 攻略内容、界面、图标或 manifest 任一变动都升版（换图标/改 manifest 视为小更新）
changed=$(git diff --cached --name-only -- "$FILE" "index.html" "manifest.json" "icons/")
if [ -z "$changed" ]; then
  exit 0
fi

cd "$ROOT" || exit 0

cur=$(grep -oE 'version: "[0-9]+\.[0-9]+\.[0-9]+"' "$FILE" | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
if [ -z "$cur" ]; then
  echo "pre-commit: 未找到 version 字段，跳过升版"
  exit 0
fi

LEVEL=${VERSION_BUMP:-patch}
maj=$(echo "$cur" | cut -d. -f1)
min=$(echo "$cur" | cut -d. -f2)
pat=$(echo "$cur" | cut -d. -f3)

case "$LEVEL" in
  major)
    maj=$((maj + 1)); min=0; pat=0
    label="大更新 +1.0.0"
    ;;
  minor)
    min=$((min + 1)); pat=0
    label="中更新 +0.1"
    ;;
  *)
    pat=$((pat + 1))
    label="小更新 +0.0.1"
    ;;
esac

new="$maj.$min.$pat"
# 只替换文件中第一处 version: "x.y.z"（即 GUIDE_META.version）
sed -i "0,/version: \"[0-9][0-9.]*\"/s//version: \"$new\"/" "$FILE"
git add "$FILE"

echo "pre-commit: [$label] 版本号 $cur -> $new"
exit 0
