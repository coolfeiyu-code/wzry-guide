#!/bin/sh
# pre-commit: 按改动范围升版
#   王者荣耀（heroes-data.js GUIDE_META）← 只在英雄攻略 / 首页 / 装备库变动时升
#   王者万象棋（wanxiangqi-data.js WXQ_META）← 只在 wanxiangqi* 变动时升
# 档位：VERSION_BUMP=major|minor|patch（缺省 patch）
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 0

LEVEL=${VERSION_BUMP:-patch}

bump_semver() {
  cur="$1"
  maj=$(echo "$cur" | cut -d. -f1)
  min=$(echo "$cur" | cut -d. -f2)
  pat=$(echo "$cur" | cut -d. -f3)
  case "$LEVEL" in
    major) maj=$((maj + 1)); min=0; pat=0; label="大更新 +1.0.0" ;;
    minor) min=$((min + 1)); pat=0; label="中更新 +0.1" ;;
    *)     pat=$((pat + 1)); label="小更新 +0.0.1" ;;
  esac
  echo "$maj.$min.$pat $label"
}

CORE=$(git diff --cached --name-only -- "heroes-data.js" "index.html" "manifest.json" "icons/" "items.html" "items-data.js" "scripts/sync-items.py" "scripts/item-changes.json")
WXQ=$(git diff --cached --name-only -- "wanxiangqi*" "scripts/sync-wxq-lineups.js")

if [ -n "$CORE" ]; then
  FILE="heroes-data.js"
  cur=$(grep -oE 'version: "[0-9]+\.[0-9]+\.[0-9]+"' "$FILE" | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  if [ -n "$cur" ]; then
    set -- $(bump_semver "$cur")
    new=$1; shift; label="$*"
    sed -i "0,/version: \"[0-9][0-9.]*\"/s//version: \"$new\"/" "$FILE"
    git add "$FILE"
    echo "pre-commit: 王者荣耀 [$label] $cur -> $new"
  fi
fi

if [ -n "$WXQ" ]; then
  FILE="wanxiangqi-data.js"
  # 本次提交已经改过 WXQ_META.version 就不再叠一次
  if git diff --cached -- "$FILE" | grep -q '"version":'; then
    echo "pre-commit: 万象棋 version 已在本次改动中更新，跳过自动升版"
  else
    cur=$(grep -oE '"version":"[0-9]+\.[0-9]+\.[0-9]+"' "$FILE" | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
    if [ -n "$cur" ]; then
      set -- $(bump_semver "$cur")
      new=$1; shift; label="$*"
      sed -i "0,/\"version\":\"[0-9][0-9.]*\"/s//\"version\":\"$new\"/" "$FILE"
      git add "$FILE"
      echo "pre-commit: 万象棋 [$label] $cur -> $new"
    fi
  fi
fi

if [ -z "$CORE" ] && [ -z "$WXQ" ]; then
  exit 0
fi

exit 0
